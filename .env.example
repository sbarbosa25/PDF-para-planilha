# Copie para .env e preencha. Não versione o .env com a chave real.

# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=(Coloque sua chave aqui)

# Modelo. Use um Sonnet atual (lê PDF e imagem).
# Confira o ID vigente em docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-5

# Porta do servidor (opcional, padrão 8000)
PORT=8000
